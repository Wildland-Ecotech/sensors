# The settings of sensors live in Docker. On a Wetfish server, adding the
# project asks for these and keeps them in config/sensors/sensors.env; on
# your own computer, copy this file to sensors.env. See docs/live.md.

# The time zone to write the logs and show times in
SENSORS_TIME_ZONE=America/Denver

# The bot's nick on IRC
SENSORS_NICK=sensors

# Other settings, shown with their defaults
#SENSORS_SERVER=irc.wetfish.net
#SENSORS_PORT=6697
#SENSORS_CHANNELS='#greenhouse'
#SENSORS_NETWORK=wetfish
